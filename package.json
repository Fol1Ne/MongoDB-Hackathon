{
  "name": "twin-data-layer",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && npm run typecheck -w @twin/web",
    "test": "vitest run",
    "test:unit": "vitest run packages",
    "test:api": "vitest run apps/api",
    "dev": "npm run dev -w @twin/api",
    "db:init": "npm run db:init -w @twin/api",
    "db:vector": "npm run db:vector -w @twin/api",
    "db:seed": "npm run db:seed -w @twin/api",
    "smoke": "npm run smoke -w @twin/api",
    "dev:web": "npm run dev -w @twin/web",
    "build:web": "npm run build -w @twin/web"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "mongodb-memory-server": "^10.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
